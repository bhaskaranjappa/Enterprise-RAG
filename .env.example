# Enterprise RAG - local environment template
# Copy this file to .env and insert your own credentials.
# Never commit the real .env file.

# Required for Groq answer generation
GROQ_API_KEY=replace_with_your_groq_api_key

# Optional: set BOTH values to use Zilliz Cloud.
# Leave both blank to use local Milvus at localhost:19530.
ZILLIZ_ENDPOINT=
ZILLIZ_TOKEN=

# Optional FastAPI runtime settings
ENV=development
PORT=8000

# Optional: used by Hugging Face Hub workflows such as sync_data.py
HF_TOKEN=
